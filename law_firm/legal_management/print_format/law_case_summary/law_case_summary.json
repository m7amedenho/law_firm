 "html": "<div style=\"direction: rtl; text-align: right; font-family: 'Traditional Arabic', 'Arial', sans-serif;\">\n\t<div style=\"text-align:center; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; margin-bottom: 15px;\">\n\t\t<h2 style=\"margin:0;\">ملخص القضية</h2>\n\t\t<div style=\"color:#555;\">{{ doc.name }}</div>\n\t</div>\n\n\t<table style=\"width:100%; border-collapse: collapse; margin-bottom: 15px;\">\n\t\t<tr>\n\t\t\t<td style=\"width:25%; font-weight:bold; padding:4px;\">عنوان القضية</td>\n\t\t\t<td style=\"width:25%; padding:4px;\">{{ doc.case_title or '' }}</td>\n\t\t\t<td style=\"width:25%; font-weight:bold; padding:4px;\">رقم الدعوى</td>\n\t\t\t<td style=\"width:25%; padding:4px;\">{{ doc.case_number or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">سنة الدعوى</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.case_year or '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">حالة القضية</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.status or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">المحكمة</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.court or '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">نوع القضية</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.case_type or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">الموكل</td>\n\t\t\t<td style=\"padding:4px;\">{{ frappe.db.get_value('Customer', doc.client, 'customer_name') if doc.client else '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">المحامي المسؤول</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.assigned_lawyer or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">الممثل القانوني للموكل</td>\n\t\t\t<td style=\"padding:4px;\">{{ frappe.db.get_value('Contact', doc.authorized_signatory, 'full_name') if doc.authorized_signatory else '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\"></td>\n\t\t\t<td style=\"padding:4px;\"></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">اسم الخصم</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.opponent_name or '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">محامي الخصم</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.opponent_lawyer or '' }}</td>\n\t\t</tr>\n\t</table>\n\n\t{% if doc.description %}\n\t<div style=\"margin-bottom:15px;\">\n\t\t<div style=\"font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:6px;\">موضوع الدعوى</div>\n\t\t<div>{{ doc.description }}</div>\n\t</div>\n\t{% endif %}\n\n\t{% set hearings = frappe.get_all(\"Case Hearing\", filters={\"case\": doc.name}, fields=[\"hearing_date\", \"hearing_time\", \"court_room\", \"hearing_status\", \"decisions\", \"next_hearing_date\"], order_by=\"hearing_date asc\") %}\n\t<div>\n\t\t<div style=\"font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:6px;\">سجل الجلسات</div>\n\t\t<table style=\"width:100%; border-collapse: collapse;\" border=\"1\">\n\t\t\t<thead>\n\t\t\t\t<tr style=\"background:#f2f2f2;\">\n\t\t\t\t\t<th style=\"padding:4px;\">التاريخ</th>\n\t\t\t\t\t<th style=\"padding:4px;\">القاعة</th>\n\t\t\t\t\t<th style=\"padding:4px;\">الحالة</th>\n\t\t\t\t\t<th style=\"padding:4px;\">القرار</th>\n\t\t\t\t\t<th style=\"padding:4px;\">الجلسة القادمة</th>\n\t\t\t\t</tr>\n\t\t\t</thead>\n\t\t\t<tbody>\n\t\t\t{% for h in hearings %}\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:4px;\">{{ frappe.utils.formatdate(h.hearing_date) if h.hearing_date else '' }}</td>\n\t\t\t\t\t<td style=\"padding:4px;\">{{ h.court_room or '' }}</td>\n\t\t\t\t\t<td style=\"padding:4px;\">{{ h.hearing_status or '' }}</td>\n\t\t\t\t\t<td style=\"padding:4px;\">{{ h.decisions or '' }}</td>\n\t\t\t\t\t<td style=\"padding:4px;\">{{ frappe.utils.formatdate(h.next_hearing_date) if h.next_hearing_date else '' }}</td>\n\t\t\t\t</tr>\n\t\t\t{% else %}\n\t\t\t\t<tr><td colspan=\"5\" style=\"padding:6px; text-align:center; color:#888;\">لا توجد جلسات مسجلة</td></tr>\n\t\t\t{% endfor %}\n\t\t\t</tbody>\n\t\t</table>\n\t</div>\n</div>\n",
