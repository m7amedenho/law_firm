 "html": "<div style=\"direction: rtl; text-align: right; font-family: 'Traditional Arabic', 'Arial', sans-serif;\">\n\t<div style=\"text-align:center; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; margin-bottom: 15px;\">\n\t\t<h2 style=\"margin:0;\">محضر جلسة</h2>\n\t</div>\n\n\t{% set case_doc = frappe.get_doc(\"Law Case\", doc.case) %}\n\t<table style=\"width:100%; border-collapse: collapse; margin-bottom: 15px;\">\n\t\t<tr>\n\t\t\t<td style=\"width:25%; font-weight:bold; padding:4px;\">القضية</td>\n\t\t\t<td style=\"width:25%; padding:4px;\">{{ case_doc.case_title or doc.case }}</td>\n\t\t\t<td style=\"width:25%; font-weight:bold; padding:4px;\">رقم الدعوى</td>\n\t\t\t<td style=\"width:25%; padding:4px;\">{{ case_doc.case_number or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">المحكمة</td>\n\t\t\t<td style=\"padding:4px;\">{{ case_doc.court or '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">القاعة</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.court_room or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">تاريخ الجلسة</td>\n\t\t\t<td style=\"padding:4px;\">{{ frappe.utils.formatdate(doc.hearing_date) if doc.hearing_date else '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">وقت الجلسة</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.hearing_time or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">اسم القاضي</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.judge_name or '' }}</td>\n\t\t\t<td style=\"font-weight:bold; padding:4px;\">حالة الجلسة</td>\n\t\t\t<td style=\"padding:4px;\">{{ doc.hearing_status or '' }}</td>\n\t\t</tr>\n\t</table>\n\n\t<div style=\"margin-bottom:15px;\">\n\t\t<div style=\"font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:6px;\">مذكرات وملاحظات الدفاع</div>\n\t\t<div>{{ doc.pleading_notes or '-' }}</div>\n\t</div>\n\n\t<div style=\"margin-bottom:15px;\">\n\t\t<div style=\"font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:6px;\">قرار المحكمة</div>\n\t\t<div>{{ doc.decisions or '-' }}</div>\n\t</div>\n\n\t{% if doc.next_hearing_date %}\n\t<div>\n\t\t<span style=\"font-weight:bold;\">الجلسة القادمة:</span>\n\t\t{{ frappe.utils.formatdate(doc.next_hearing_date) }}\n\t</div>\n\t{% endif %}\n</div>\n",
